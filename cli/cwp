# ---------------------------------------------------------------------------
# Main argument parser
# ---------------------------------------------------------------------------
main() {
    load_config

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host)       CWP_HOST="$2"; shift 2 ;;
            --api-key)    CWP_API_KEY="$2"; shift 2 ;;
            --api-port)   CWP_API_PORT="$2"; shift 2 ;;
            --ssh-user)   SSH_USER="$2"; shift 2 ;;
            --ssh-port)   SSH_PORT="$2"; shift 2 ;;
            --ssh-key)    SSH_KEY="$2"; shift 2 ;;
            --output)     OUTPUT_FORMAT="$2"; shift 2 ;;
            --verbose)    VERBOSE=1; shift ;;
            -v|--version) echo "CWP CLI v${VERSION}"; exit 0 ;;
            -h|--help)    usage; exit 0 ;;
            setup)        shift; cmd_setup "$@"; exit $? ;;
            status)       shift; cmd_status "$@"; exit $? ;;
            user)         shift; cmd_user "$@"; exit $? ;;
            database)     shift; cmd_database "$@"; exit $? ;;
            email)        shift; cmd_email "$@"; exit $? ;;
            dns)          shift; cmd_dns "$@"; exit $? ;;
            ssl)          shift; cmd_ssl "$@"; exit $? ;;
            security)     shift; cmd_security "$@"; exit $? ;;
            backup)       shift; cmd_backup "$@"; exit $? ;;
            service)      shift; cmd_service "$@"; exit $? ;;
            php)          shift; cmd_php "$@"; exit $? ;;
            fix)          shift; cmd_fix "$@"; exit $? ;;
            optimize)     shift; cmd_optimize "$@"; exit $? ;;
            migrate)      shift; cmd_migrate "$@"; exit $? ;;
            logs)         shift; cmd_logs "$@"; exit $? ;;
            -*)           die "Unknown option: $1. Use --help for usage." ;;
            *)            die "Unknown command: $1. Use --help for usage." ;;
        esac
    done

    usage
}

# ---------------------------------------------------------------------------
# Setup command (interactive)
# ---------------------------------------------------------------------------
cmd_setup() {
    echo -e "${BOLD}=== CWP CLI Setup ===${NC}\n"

    read -rp "CWP Server Host/IP [$CWP_HOST]: " input
    CWP_HOST="${input:-$CWP_HOST}"

    read -rp "CWP API Key []: " input
    CWP_API_KEY="${input:-$CWP_API_KEY}"

    read -rp "CWP API Port [$CWP_API_PORT]: " input
    CWP_API_PORT="${input:-$CWP_API_PORT}"

    read -rp "SSH User [$SSH_USER]: " input
    SSH_USER="${input:-$SSH_USER}"

    read -rp "SSH Port [$SSH_PORT]: " input
    SSH_PORT="${input:-$SSH_PORT}"

    read -rp "SSH Key Path [$SSH_KEY]: " input
    SSH_KEY="${input:-$SSH_KEY}"

    save_config

    echo ""
    log_info "Testing connection..."
    if remote_exec "echo ok" &>/dev/null; then
        log_info "Connection successful!"
    else
        log_warn "Could not connect. Verify your settings."
    fi
}

# Run
main "$@"
