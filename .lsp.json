{
  "php": {
    "command": "intelephense",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".php": "php"
    },
    "initializationOptions": {
      "storagePath": "${CLAUDE_PLUGIN_DATA}/intelephense"
    },
    "settings": {
      "intelephense.environment.phpVersion": "8.3",
      "intelephense.diagnostics.enable": true,
      "intelephense.diagnostics.run": "onType"
    },
    "restartOnCrash": true,
    "maxRestarts": 3,
    "diagnostics": true
  },
  "json": {
    "command": "vscode-json-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".json": "json",
      ".jsonc": "json"
    },
    "initializationOptions": {
      "provideFormatter": true
    },
    "settings": {
      "json": {
        "validate": { "enable": true },
        "format": { "enable": true }
      }
    },
    "restartOnCrash": true,
    "maxRestarts": 3,
    "diagnostics": true
  },
  "javascript": {
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".js": "javascript",
      ".mjs": "javascript",
      ".cjs": "javascript"
    },
    "settings": {
      "javascript": {
        "validate": { "enable": true },
        "suggestionActions": { "enabled": true }
      }
    },
    "restartOnCrash": true,
    "maxRestarts": 3,
    "diagnostics": true
  },
  "bash": {
    "command": "bash-language-server",
    "args": ["start"],
    "extensionToLanguage": {
      ".sh": "bash",
      ".bash": "bash"
    },
    "restartOnCrash": true,
    "maxRestarts": 3,
    "diagnostics": true
  }
}
